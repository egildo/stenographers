{
  "name": "stenographers",
  "version": "0.4.0",
  "description": "Write an edited document back into the Markdown it was read from, keeping the author's bytes: a stenographer per node writes over the node's old slice in the author's style, every node that still means what it meant keeps its bytes, and only typed text is escaped. With a Markdown writer for Provenance, by shape.",
  "type": "module",
  "exports": {
    "./parse": "./src/parse.js",
    "./html": "./src/html.js",
    "./write": "./src/write.js",
    "./flow": "./src/flow.js",
    "./writer": "./src/writer.js"
  },
  "files": [
    "src",
    "README.md"
  ],
  "scripts": {
    "test": "node --test test/*.test.js"
  },
  "dependencies": {
    "mdast-util-directive": "3.1.0",
    "mdast-util-from-markdown": "2.0.2",
    "mdast-util-frontmatter": "2.0.1",
    "mdast-util-gfm-autolink-literal": "2.0.1",
    "mdast-util-gfm-footnote": "2.1.0",
    "mdast-util-gfm-strikethrough": "2.0.0",
    "mdast-util-gfm-table": "2.0.0",
    "mdast-util-gfm-task-list-item": "2.0.0",
    "mdast-util-math": "3.0.0",
    "mdast-util-to-hast": "13.2.1",
    "micromark-extension-directive": "3.0.2",
    "micromark-extension-frontmatter": "2.0.0",
    "micromark-extension-gfm-autolink-literal": "2.1.0",
    "micromark-extension-gfm-footnote": "2.1.0",
    "micromark-extension-gfm-strikethrough": "2.1.0",
    "micromark-extension-gfm-table": "2.1.1",
    "micromark-extension-gfm-task-list-item": "2.1.0",
    "micromark-extension-math": "3.1.0"
  },
  "devDependencies": {
    "happy-dom": "20.14.6"
  },
  "repository": {
    "type": "git",
    "url": "https://codeberg.org/egildo/stenographers.git"
  },
